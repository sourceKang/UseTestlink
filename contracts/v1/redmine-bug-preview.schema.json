{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qa-mcp-contracts:v1:redmine-bug-preview",
  "title": "Redmine bug preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "environment",
    "mode",
    "preview_digest",
    "planned_write",
    "action",
    "dedupe_digest",
    "manager_fields_enabled",
    "blocked_fields",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "environment": {"enum": ["corp", "sandbox"]},
    "mode": {"const": "preview"},
    "preview_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planned_write": {"type": "boolean"},
    "action": {"enum": ["create", "reuse", "blocked"]},
    "dedupe_digest": {"type": "string", "minLength": 8, "maxLength": 64},
    "existing_issue": {"$ref": "#/$defs/issue"},
    "manager_fields_enabled": {"type": "boolean"},
    "blocked_fields": {
      "type": "array",
      "items": {"enum": ["assigned_to_id", "fixed_version_id"]},
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "maxLength": 2000}
    }
  },
  "$defs": {
    "issue": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "url", "subject", "state"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "subject": {"type": "string"},
        "state": {"enum": ["open", "closed"]}
      }
    }
  }
}
