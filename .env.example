TESTLINK_AGENT_PROFILE=corp
TESTLINK_URL=https://your-testlink.example.com/testlink
TESTLINK_DEVKEY=replace-with-your-personal-api-access-key
TESTLINK_AUTHOR_LOGIN=your-testlink-login
# testlink_link_bug: your own numeric TestLink user ID, recorded as the tester. No default.
TESTLINK_TESTER_ID=
# Optional: TestLink web root for CA_set_result.php; must be on the TESTLINK_URL host.
# TESTLINK_WEB_BASE_URL=https://your-testlink.example.com/testlink
TESTLINK_AGENT_ENV_FILE=local/testlink_agent.env
TESTLINK_MCP_ENV_FILE=local/testlink_mcp.env
REDMINE_MCP_ENV_FILE=local/redmine_mcp.env
QA_TESTLINK_MCP_ENV_FILE=local/testlink_mcp.env
QA_REDMINE_MCP_ENV_FILE=local/redmine_mcp.env
REDMINE_ENV=corp
REDMINE_URL=https://your-redmine.example.com
REDMINE_API_KEY=replace-with-your-redmine-api-key
REDMINE_PROJECT_ID=redmine-project-identifier
REDMINE_TEMPLATE=local/redmine_templates/your-redmine-project.json
REDMINE_TRACKER_ID=1
REDMINE_PRIORITY_ID=5
