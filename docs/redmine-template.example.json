{
  "project_id": "redmine-project-identifier",
  "tracker_id": 1,
  "severity": {
    "transport_field": "priority_id",
    "default": "L2",
    "values": {
      "L3": 4,
      "L2": 5,
      "L1": 6
    }
  },
  "priority": {
    "transport_field": "custom_fields",
    "custom_field_id": 119,
    "allowed_values": [],
    "default": null
  },
  "required_custom_fields": [
    "FW Ver",
    "Product Line",
    "Model",
    "Customer",
    "Test plan ver",
    "Test case No",
    "Report Date",
    "Reporter dept",
    "Reporter",
    "Service Type"
  ],
  "custom_fields": [
    {
      "id": 2,
      "name": "FW Ver",
      "value": "{{header.EMS Version}}"
    },
    {
      "id": 3,
      "name": "Product Line",
      "value": "EMS"
    },
    {
      "id": 4,
      "name": "Model",
      "value": "{{env.REDMINE_MODEL}}"
    },
    {
      "id": 5,
      "name": "Customer",
      "value": "{{env.REDMINE_CUSTOMER}}"
    },
    {
      "id": 6,
      "name": "Test plan ver",
      "value": "{{context.plan.name}}"
    },
    {
      "id": 7,
      "name": "Test case No",
      "value": "{{result.external_id}}"
    },
    {
      "id": 8,
      "name": "Report Date",
      "value": "{{report_date}}"
    },
    {
      "id": 9,
      "name": "Reporter dept",
      "value": "{{env.REDMINE_REPORTER_DEPT}}"
    },
    {
      "id": 10,
      "name": "Reporter",
      "value": "{{env.REDMINE_REPORTER}}"
    },
    {
      "id": 11,
      "name": "Service Type",
      "value": "Testing"
    }
  ]
}
